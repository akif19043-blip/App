# ── Database ────────────────────────────────────────────────────────────────
# Leave unset for local dev: an embedded Postgres (PGlite) is created in .data/,
# migrated and seeded with demo accounts automatically.
#
# Production: Supabase (or any Postgres 14+). Use the DIRECT connection or the
# SESSION pooler (port 5432) — LISTEN/NOTIFY does not work through the
# transaction pooler (port 6543).
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# DATABASE_POOL_SIZE=10
# DB_AUTO_MIGRATE=false        # true = run migrations on boot instead of `npm run db:migrate`

# PGLITE_DATA_DIR=.data/pglite # or memory:// for a throwaway DB
# SEED_DEMO_DATA=true

# ── LiveKit (WebRTC video, sub-second latency) ──────────────────────────────
# Without these the room still works; the host sees a local camera preview only.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ── Payments (BLIK via Przelewy24 — mocked) ─────────────────────────────────
# Simulated "confirm in your bank app" delay.
# BLIK_MOCK_DELAY_MS=1500

# ── InPost ──────────────────────────────────────────────────────────────────
# Shared secret for POST /api/webhooks/inpost (Authorization: Bearer …)
# INPOST_WEBHOOK_SECRET=

# ── Auctions ────────────────────────────────────────────────────────────────
# Serverless deploys (no long-lived process for the settlement sweeper) should
# call GET /api/cron/settle every few seconds with this bearer token.
# CRON_SECRET=
# SETTLE_SWEEP_MS=250

# Demo helpers (e.g. "deliver to Paczkomat" button). Default: on without DATABASE_URL.
# ENABLE_DEMO_TOOLS=false
