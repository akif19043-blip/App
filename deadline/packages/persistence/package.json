    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@deadline/shared": "workspace:*",
    "@supabase/supabase-js": "^2.48.1"
  },
  "devDependencies": {
    "@deadline/config": "workspace:*",
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
