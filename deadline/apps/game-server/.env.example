# ---------------------------------------------------------------------------
# DEADLINE — environment configuration
#
# Copy to `.env` at the repository root. Every value below has a working
# default for local development: with NO Supabase project configured the game
# runs in demo mode against a local file database, and the whole loop
# (deploy → loot → extract → stash) still works.
#
# Never commit a real service-role key.
# ---------------------------------------------------------------------------

# --- Supabase (persistent player data) -------------------------------------
# Leave empty to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Optional overrides used by the game server (defaults to the NEXT_PUBLIC_ values).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Web client -------------------------------------------------------------
NEXT_PUBLIC_GAME_SERVER_URL=ws://localhost:2567
NEXT_PUBLIC_DEMO_MODE=true

# --- Game server ------------------------------------------------------------
GAME_SERVER_PORT=2567
GAME_SERVER_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Allows unauthenticated "demo" joins. MUST be false in production.
ALLOW_DEMO_AUTH=true
# Exposes the in-raid debug panel. Defaults to false when NODE_ENV=production.
ENABLE_DEBUG_TOOLS=true

# --- Match configuration ----------------------------------------------------
MATCH_DURATION_SECONDS=600
FINAL_PHASE_SECONDS=120
ALARM_SECONDS=60
COUNTDOWN_SECONDS=5
MAX_PLAYERS=8
MIN_PLAYERS_TO_START=1
LOBBY_FILL_SECONDS=15
SERVER_TICK_RATE=25
SNAPSHOT_RATE=20
EXTRACTION_TIME_SECONDS=5
EXTRACTIONS_PER_PLAYER=2
DISCONNECT_GRACE_SECONDS=30

# --- Bots and AI ------------------------------------------------------------
ENABLE_BOTS=true
BOT_COUNT=4
BOT_DIFFICULTY=normal
MAX_AI_ENEMIES=26

# --- Economy and progression ------------------------------------------------
STARTING_CREDITS=10000
VENDOR_SELL_RATIO=0.55
LOOT_MULTIPLIER=1
XP_MULTIPLIER=1
PERK_SLOTS=2
ALLOW_LEGENDARY_IN_SECURE=true

# --- Events -----------------------------------------------------------------
SUPPLY_DROP_AT_SECONDS=300
SUPPLY_DROP_TRAVEL_SECONDS=20

# --- Local development ------------------------------------------------------
# Where the demo (no-Supabase) database lives. Both the web app and the game
# server open this same file, which is what makes the loop work offline.
DEMO_DB_PATH=
ANALYTICS_DEBUG=false
