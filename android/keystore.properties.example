# Copy to android/keystore.properties and fill in. Never commit the real file.
#
# Create the key once (keep the .jks and these passwords safe and backed up --
# Play will not accept an update signed with a different key):
#
#   keytool -genkey -v -keystore dortyol-release.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias dortyol
#
storeFile=../dortyol-release.jks
storePassword=CHANGE_ME
keyAlias=dortyol
keyPassword=CHANGE_ME
